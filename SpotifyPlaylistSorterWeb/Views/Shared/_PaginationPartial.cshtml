@model IPaginatedList

@{
  var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
  var nextDisabled = !Model.HasNextPage ? "disabled" : "";
  var baseRouteValues = new RouteValueDictionary();

  if (Model.RouteValues != null)
  {
    foreach(var value in Model.RouteValues)
    {
      baseRouteValues[value.Key] = value.Value;
    }
  }
}

<div>
  <ul class="pagination">
    <li class="page-item @prevDisabled">
      <a asp-action="@Model.Action"
        asp-all-route-data="@Model.RouteValues"
        asp-route-page="@(Model.Index - 1)"
        asp-route-pageSize="@(Model.Limit)"
        class="page-link @prevDisabled">
          Previous
      </a>
    </li>
    <li class="page-item @nextDisabled">
      <a asp-action="@Model.Action"
        asp-all-route-data="@Model.RouteValues"
        asp-route-page="@(Model.Index + 1)"
        asp-route-pageSize="@(Model.Limit)"
        class="page-link @nextDisabled">
          Next
      </a>
    </li>
  </ul>
</div>